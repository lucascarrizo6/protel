# Copiá este archivo como .env y pedile los valores reales a Lucas (no van en git).

# Base de datos (Railway PostgreSQL — conexión pública, no la interna)
DATABASE_URL="postgresql://user:password@host:port/railway"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generar con: openssl rand -base64 32"

# Cron jobs
CRON_SECRET="pedir valor real — si falta, los endpoints de cron devuelven 401 (fail-closed)"

# MercadoPago Checkout Pro
MP_PUBLIC_KEY="pedir valor real"
MP_ACCESS_TOKEN="pedir valor real"
MP_WEBHOOK_SECRET="pedir valor real (panel de webhooks de MercadoPago)"

# Seed (passwords de usuarios demo)
SEED_ADMIN_PASSWORD="pedir valor real"
SEED_SUPER_PASSWORD="pedir valor real"
