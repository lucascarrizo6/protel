// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  HOTEL_ADMIN
  RECEPTIONIST
  HOUSEKEEPING
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
  CLEANING
  MANTENIMIENTO
}

enum BedArrangement {
  SIMPLE
  DOBLE
  TWIN
  TRIPLE
  FAMILIAR
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum HousekeepingStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
}

enum InvoiceStatus {
  PENDIENTE
  PAGADA
  CANCELADA
}

enum InvoiceType {
  ALOJAMIENTO
  CONSUMOS
}

enum DocumentType {
  DNI
  PASAPORTE
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA
  MERCADO_PAGO
}

enum TipoFacturaAfip {
  A
  B
  C
}

enum AfipAmbiente {
  SANDBOX
  PRODUCCION
}

model Hotel {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users             User[]
  rooms             Room[]
  reservations      Reservation[]
  housekeepingTasks HousekeepingTask[]
  invoices          Invoice[]
  groups            Group[]
  afipConfig        AfipConfig?
  modules           HotelModules?
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RECEPTIONIST)
  createdAt    DateTime @default(now())

  hotelId String?
  hotel   Hotel?  @relation(fields: [hotelId], references: [id])

  @@index([hotelId])
}

model Room {
  id            String     @id @default(cuid())
  number        String
  floor         Int
  type          String
  status        RoomStatus @default(AVAILABLE)
  notes         String?
  capacity      Int        @default(2)
  pricePerNight Float      @default(0)

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  reservations     Reservation[]
  housekeepingTask HousekeepingTask?
  groupMembers     GroupMember[]

  @@unique([hotelId, number])
  @@index([hotelId])
}

model HousekeepingTask {
  id          String             @id @default(cuid())
  status      HousekeepingStatus @default(PENDIENTE)
  limpiadaHoy Boolean            @default(false)
  priority    Boolean            @default(false)
  notes       String?
  reason      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  roomId String @unique
  room   Room   @relation(fields: [roomId], references: [id])

  @@index([hotelId])
}

model Reservation {
  id           String            @id @default(cuid())
  guestName    String
  dni          String
  documentType DocumentType      @default(DNI)
  email        String?
  phone        String?
  checkIn      DateTime
  checkOut     DateTime
  status       ReservationStatus @default(PENDIENTE)
  extras       Json?
  createdAt    DateTime          @default(now())

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  invoices    Invoice[]
  groupMember GroupMember?

  @@index([hotelId])
  @@index([roomId])
  @@index([hotelId, checkIn])
  @@index([hotelId, status])
}

model Invoice {
  id            String         @id @default(cuid())
  amount        Float
  status        InvoiceStatus  @default(PENDIENTE)
  type          InvoiceType    @default(ALOJAMIENTO)
  paymentMethod PaymentMethod?
  createdAt     DateTime       @default(now())

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([hotelId])
  @@index([reservationId])
  @@index([hotelId, createdAt])
}

model Group {
  id               String   @id @default(cuid())
  nombre           String
  fechaEntrada     DateTime
  fechaSalida      DateTime
  cantidadPersonas Int
  creadoEn         DateTime @default(now())

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  members GroupMember[]

  @@index([hotelId])
}

model GroupMember {
  id              String         @id @default(cuid())
  nombre          String
  dni             String
  documentType    DocumentType   @default(DNI)
  esFree          Boolean        @default(false)
  disposicionCama BedArrangement

  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  @@index([groupId])
}

model HotelModules {
  id          String  @id @default(cuid())
  hotelId     String  @unique
  hotel       Hotel   @relation(fields: [hotelId], references: [id])
  mercadopago Boolean @default(true)
  afip        Boolean @default(true)
  grupos      Boolean @default(true)
  mucama      Boolean @default(true)
  calendario  Boolean @default(true)
  reservas    Boolean @default(true)
}

model AfipConfig {
  id                 String          @id @default(cuid())
  cuit               String
  // Certificado (.crt) y clave privada (.key) cifrados con AES-256-GCM
  // (ver src/lib/encryption.ts) antes de guardarse, nunca en texto plano.
  certificado        String
  clavePrivada       String
  puntoVenta         Int
  tipoFacturaDefault TipoFacturaAfip @default(B)
  ambiente           AfipAmbiente    @default(SANDBOX)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  hotelId String @unique
  hotel   Hotel  @relation(fields: [hotelId], references: [id])
}

model LoginAttempt {
  id       String   @id @default(cuid())
  email    String
  ip       String
  exitoso  Boolean
  creadoEn DateTime @default(now())

  @@index([email, creadoEn])
}
